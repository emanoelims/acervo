        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (state) (increase({__name__=~\"oban_job_stop_count|oban_job_exception_count\",app=\"acervo-app\"}[$__rate_interval]))",
