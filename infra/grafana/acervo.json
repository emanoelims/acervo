    {
      "type": "stat",
      "id": 9,
      "title": "Partial rate",
      "description": "Searches answered by text only because the embedding was late or failed",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(acervo_search_total{app=\"acervo-app\",partial=\"true\"}[$__range])) / sum(increase(acervo_search_total{app=\"acervo-app\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
