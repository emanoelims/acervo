# Copie para `mise.local.toml` (gitignored) e preencha os valores.
# O mise carrega este arquivo automaticamente por cima do `mise.toml`.
[env]
ANTHROPIC_API_KEY = ""
# Optional in dev; required in production
# ACERVO_ALLOWED_EMAILS = ""
# Required in production: Resend API key and the sender address
# RESEND_API_KEY = ""
# MAIL_FROM = ""
